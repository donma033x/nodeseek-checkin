# NodeSeek Cookie（多账号用 & 分隔）
NODESEEK_COOKIE=

# 账号密码（多账号用 & 分隔，格式: user:pass）
NODESEEK_ACCOUNT=user1:pass1

# DeepFlood Cookie（可选，不设置则自动通过 OAuth 获取）
DEEPFLOOD_COOKIE=

# 是否随机签到
NODESEEK_RANDOM=true

# YesCaptcha API Key（登录时需要，解决 Turnstile）
YESCAPTCHA_API_KEY=

# Telegram 通知（可选）
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
